{
  "name": "download1999",
  "version": "1.4.2",
  "description": "本脚本程序仅用于批量下载1999国服官网的图片，仅作为技术分享，请勿用于其他用途。侵权请联系删除。",
  "main": "src/app.ts",
  "type": "module",
  "private": false,
  "scripts": {
    "prepare": "husky && node scripts/warn-env.js",
    "lint-staged": "lint-staged",
    "check:type": "vue-tsc --build --noEmit --force",
    "check:prettier": "prettier --check .",
    "check": "eslint .",
    "lint": "eslint . --fix",
    "lint:prettier": "prettier . --write",
    "lint:commitlint": "commitlint --edit $1",
    "lint:diff": "pnpm exec lint-staged",
    "commit": "pnpm run lint:diff && cz",
    "start": "cross-env NODE_ENV=development TS_NODE_PROJECT=tsconfig.dev.json nodemon --exec tsx src/app.ts",
    "start:prod": "pnpm build && cross-env NODE_ENV=production tsx dist/app.js",
    "build": "tsc",
    "pkg": "pkg --options no-warnings --targets node18-win-x64",
    "build:app": "tsup && cross-env NODE_ENV=production npm run pkg -- dist/app.cjs --output dist/1999批量下载器_v1.4.2_win_x64.exe",
    "push": "git push Gitee master && git push Github master"
  },
  "keywords": [],
  "author": "默默[https://gitee.com/MuXi-Dream]",
  "license": "MIT",
  "packageManager": "pnpm@10.11.0",
  "lint-staged": {
    "**/*.{cjs,mjs,js,jsx,tsx,ts,less}": [
      "pnpm exec eslint --fix"
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "dependencies": {
    "@types/probe-image-size": "^7.2.5",
    "@types/semver": "^7.7.0",
    "axios": "^0.27.2 ",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "http-proxy-middleware": "^3.0.5",
    "probe-image-size": "^7.2.3",
    "semver": "^7.7.2",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/types": "^19.8.1",
    "@eslint/js": "^9.27.0",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.21",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "cross-env": "^7.0.3",
    "cz-git": "^1.11.1",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "globals": "^16.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "nodemon": "^3.1.10",
    "pkg": "^5.8.1",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript-eslint": "^8.32.1"
  }
}
